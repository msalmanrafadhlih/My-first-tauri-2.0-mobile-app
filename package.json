{
  "name": "pocket-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:client": "cd apps/client && bun run dev",
    "dev:server": "cd apps/server && bun run dev",
    "build:client": "cd apps/client && bun run build",
    "build:server": "cd apps/server && bun run start",
    "build:desktop": "cd apps/client && bun run tauri build",
    "build:android": "cd apps/client && bun run tauri android build",
    "desktop": "cd apps/client && pnpm dlx @tauri-apps/cli dev",
    "android": "cd apps/client && pnpm dlx @tauri-apps/cli android dev",

    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  }
}
